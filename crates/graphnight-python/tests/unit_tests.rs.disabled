use graphnight_core::models::*;
use graphnight_sql::dialects::get_dialect;
use graphnight_sql::executor::{ConnectionManager, QueryExecutor};
use graphnight_sql::SqlEngine;
use graphnight_storage::YamlStorage;
use graphnight_storage::StorageBackend;
use graphnight::GraphNightClient;
use tempfile::tempdir;
use std::sync::Arc;
use pyo3::Python;

async fn setup_test_client() -> GraphNightClient {
    let dir = tempdir().unwrap();
    let storage = Arc::new(YamlStorage::new(dir.path()).unwrap());
    
    // Create datasource
    let ds = DataSource {
        name: "postgres".to_string(),
        driver: "postgres".to_string(),
        connection_string: "postgresql://localhost/test".to_string(),
        description: None,
        models: vec!["orders".to_string()],
        pool_size: Some(5),
        meta: Default::default(),
    };
    storage.create_datasource(ds).await.unwrap();
    
    // Create model
    let model = Model {
        name: "orders".to_string(),
        datasource: "postgres".to_string(),
        description: Some("Test orders model".to_string()),
        measures: vec![
            Measure::simple("revenue", AggregationType::Sum),
            Measure::simple("order_count", AggregationType::Count),
        ],
        dimensions: vec![
            Dimension::new("status"),
            Dimension::new("store_id"),
        ],
        time_dimensions: vec![
            TimeDimension::new("created_at", TimeGranularity::Day),
        ],
        joins: vec![],
        sql: None,
        meta: Default::default(),
    };
    storage.create_model(model).await.unwrap();
    storage.create_model(model).await.unwrap();
    
    let dialect = get_dialect("postgres");
    let conn_manager = Arc::new(ConnectionManager::new());
    let executor = Arc::new(QueryExecutor::new(conn_manager));
    let sql_engine = Arc::new(SqlEngine::new(dialect, executor).unwrap());
    
    GraphNightClient { sql_engine, storage }
}

#[tokio::test]
async fn test_python_client_new() {
    let client = setup_test_client().await;
    // Just verify it constructs
    assert!(std::sync::Arc::strong_count(&client.sql_engine) >= 1);
}

#[tokio::test]
async fn test_list_models() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let result = client.list_models(py, None).unwrap();
        // Result should be a Python list
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_get_model() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let result = client.get_model(py, "orders".to_string(), None).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_list_datasources() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let result = client.list_datasources(py).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_save_memory() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let result = client.save_memory(
            py,
            "Test memory".to_string(),
            vec!["revenue:sum".to_string()],
            Some("mem_1".to_string()),
            Some("Test description".to_string()),
        ).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_list_memories() {
    let client = setup_test_client().await;
    
    // Save a memory first
    Python::with_gil(|py| {
        client.save_memory(
            py,
            "Test memory".to_string(),
            vec!["revenue:sum".to_string()],
            Some("mem_1".to_string()),
            Some("Test description".to_string()),
        ).unwrap();
    });
    
    Python::with_gil(|py| {
        let result = client.list_memories(py, None, None, Some(10), Some(0)).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_forget_memory() {
    let client = setup_test_client().await;
    
    // Save a memory first
    Python::with_gil(|py| {
        client.save_memory(
            py,
            "Test memory".to_string(),
            vec!["revenue:sum".to_string()],
            Some("mem_1".to_string()),
            Some("Test description".to_string()),
        ).unwrap();
    });
    
    Python::with_gil(|py| {
        let result = client.forget_memory(py, "mem_1".to_string()).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_search() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let result = client.search(py, "revenue".to_string(), Some(10)).unwrap();
        assert!(!result.is_none(py));
    });
}

#[tokio::test]
async fn test_generate_sql() {
    let client = setup_test_client().await;
    
    Python::with_gil(|py| {
        let dict = pyo3::types::PyDict::new(py);
        dict.set_item("name", "orders").unwrap();
        
        let result = client.generate_sql(py, &dict).unwrap();
        assert!(!result.is_none(py));
    });
}