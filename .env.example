# GRAPHNIGHT_HOST=127.0.0.1
# GRAPHNIGHT_PORT=8080
# GRAPHNIGHT_STORAGE_PATH=./graphnight_data

# Auth (v0.2) — when API keys or OIDC are set, GraphQL requires auth unless DEV_OPEN=1
# GRAPHNIGHT_API_KEYS=alice:secret1,bob:secret2
# GRAPHNIGHT_ADMIN_KEYS=admin:adminsecret
# GRAPHNIGHT_AUTH_REQUIRED=1
# GRAPHNIGHT_DEV_OPEN=1

# OIDC JWT bearer (SSO) — issuer enables JWKS validation; no browser login UI
# GRAPHNIGHT_OIDC_ISSUER=https://login.example.com/realms/app
# GRAPHNIGHT_OIDC_AUDIENCE=graphnight-api
# GRAPHNIGHT_OIDC_CLIENT_ID=graphnight
# GRAPHNIGHT_OIDC_ADMIN_CLAIM=roles
# GRAPHNIGHT_OIDC_ADMIN_VALUES=admin
# GRAPHNIGHT_OIDC_TENANT_CLAIM=tenant_id

# CORS — unset = localhost only (http://127.0.0.1:8080, http://localhost:8080)
# GRAPHNIGHT_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# GRAPHNIGHT_CORS_ORIGINS=*   # open CORS (warns in logs)

# TLS — terminate at reverse proxy; in-process TLS is not implemented

# Datasource secrets — prefer env refs over plaintext in config / GraphQL
# GRAPHNIGHT_DATASOURCE_DEMO=postgresql://user:pass@localhost:5432/analytics
# In graphnight.toml: connection_string = "env:GRAPHNIGHT_DATASOURCE_DEMO"
# GRAPHNIGHT_REQUIRE_SECRET_REFS=1   # GraphQL mutations must use env:VARNAME

# HA metadata storage (storage.type = "postgres")
# Used when [storage].path is unset, or via path = "env:GRAPHNIGHT_METADATA_DATABASE_URL"
# GRAPHNIGHT_METADATA_DATABASE_URL=postgresql://graphnight:graphnight@127.0.0.1:5433/graphnight_meta
# docker compose --profile ha up metadata-db
